NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/iro
BCRYPT_SALT_ROUNDS=12
DEFAULT_PASS=default12345
LOG_LEVEL=info

# generate each with: openssl rand -hex 48   (must be different from each other)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# lax: same site (localhost / subdomains) · none: admin on a different domain (needs HTTPS)
COOKIE_SAMESITE=lax

RESET_PASS_UI_LINK=http://localhost:3000/admin
CLOUDINARY_CLOUD_NAME=put_your_coudinary_cloud_name
CLOUDINARY_API_KEY=put_your_coudinary_api_key
CLOUDINARY_API_SECRET=put_your_coudinary_api_secret

# comma separated browser origins allowed by CORS
FRONTEND_URLS=http://localhost:3000
# optional: refresh the public website cache when content changes (same secret in the frontend .env)
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me

# first super admin, created automatically on first start
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345
